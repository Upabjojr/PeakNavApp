{
  "openapi": "3.0.3",
  "info": {
    "title": "PeakNav headless renderer",
    "description": "REST control of an off-screen PeakNav instance. Start it with `peaknav-headless --lat <deg> --lon <deg> --serve 0`; the chosen port is printed as `PEAKNAV_SERVE port=N`. The server binds to 127.0.0.1 and handles one request at a time: the renderer is a single camera and framebuffer, so requests are deliberately serialised. Point Swagger UI or any OpenAPI generator at /openapi.json.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "8080"
        }
      }
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "summary": "Liveness, and whether an orbit is running",
        "responses": {
          "200": {
            "description": "Always ok when reachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "orbiting": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/position": {
      "post": {
        "summary": "Move the viewpoint to a coordinate",
        "description": "Optionally downloads missing map data for the area and waits for the view to go quiet before returning - do both before the first /frame at a new place.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "lat",
                  "lon"
                ],
                "properties": {
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lon": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "download_timeout_ms": {
                    "type": "integer",
                    "description": "Fetch missing elevation/map/imagery for the area, up to this long."
                  },
                  "await_tiles_ms": {
                    "type": "integer",
                    "description": "Wait for tiles and imagery to finish streaming, up to this long."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Moved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "downloaded": {
                      "type": "boolean"
                    },
                    "quiet": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/camera": {
      "post": {
        "summary": "Aim and place the camera",
        "description": "Height is one of three explicit forms - metres above sea level, metres above the ground, or the UI's elevation-bar fraction (0..1, exponential). Giving more than one is an error.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bearing_deg": {
                    "type": "number",
                    "description": "Compass bearing to face; 0 = north, 90 = east."
                  },
                  "pitch_deg": {
                    "type": "number",
                    "description": "Camera pitch; negative looks down."
                  },
                  "altitude_asl_m": {
                    "type": "number",
                    "description": "Absolute height above sea level - what a video wants, so ridges do not bob the camera."
                  },
                  "elevation_above_ground_m": {
                    "type": "number"
                  },
                  "elevation_bar": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied"
          },
          "400": {
            "description": "Conflicting heights or bad values"
          }
        }
      }
    },
    "/view": {
      "post": {
        "summary": "Display options - set exactly the fields you name",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sky": {
                    "type": "boolean"
                  },
                  "sky_mode": {
                    "type": "string",
                    "enum": [
                      "local",
                      "day",
                      "night"
                    ]
                  },
                  "constellations": {
                    "type": "boolean"
                  },
                  "star_names": {
                    "type": "boolean"
                  },
                  "sky_labels": {
                    "type": "boolean",
                    "description": "Master switch over every caption on the sky."
                  },
                  "sky_grid": {
                    "type": "boolean"
                  },
                  "ecliptic": {
                    "type": "boolean"
                  },
                  "sky_time": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Freeze the sky and sunlight at this UTC instant, e.g. 2026-07-15T09:30:00Z - renders stop depending on when they run."
                  },
                  "sky_time_label": {
                    "type": "boolean",
                    "description": "The date-and-time pill shown while the sky is frozen."
                  },
                  "sun_shading": {
                    "type": "boolean"
                  },
                  "horizon_compass": {
                    "type": "boolean"
                  },
                  "coordinates": {
                    "type": "boolean"
                  },
                  "corner_compass": {
                    "type": "boolean"
                  },
                  "labels": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "peaks",
                        "place_names",
                        "cities",
                        "islands",
                        "lakes",
                        "mountain_ranges",
                        "alpine_huts",
                        "pistes",
                        "roads"
                      ]
                    },
                    "description": "Whitelist: everything off, then the named kinds on."
                  },
                  "satellite_provider": {
                    "type": "string",
                    "description": "id of a known imagery source; GET /providers lists them"
                  },
                  "satellite_template": {
                    "type": "string",
                    "description": "URL template of any XYZ tile server, with {x} {y} {z} - selects it, adding it if new; takes precedence over satellite_provider"
                  },
                  "satellite_name": {
                    "type": "string",
                    "description": "display name for satellite_template"
                  },
                  "satellite_attribution": {
                    "type": "string",
                    "description": "attribution for satellite_template"
                  },
                  "label_auto_update": {
                    "type": "boolean",
                    "description": "whether the renderer recomputes label visibility on its own"
                  },
                  "refresh_labels": {
                    "type": "boolean",
                    "description": "run one label visibility pass now; needed after changing 'labels', and applied BEFORE it within a request, so send it as a separate call"
                  },
                  "fov": {
                    "type": "number",
                    "description": "Vertical field of view in degrees. The app's map uses 30; its GPX tour 62, to keep the mountains either side of a track in shot. Holds until set again."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied"
          },
          "400": {
            "description": "Unknown label or sky_mode"
          }
        }
      }
    },
    "/wait": {
      "post": {
        "summary": "Let the view finish before reading a frame",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tiles_timeout_ms": {
                    "type": "integer",
                    "description": "Wait for tile/imagery streaming to go quiet."
                  },
                  "settle_ms": {
                    "type": "integer",
                    "description": "A plain pause on top, for label fade-ins."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Done",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "quiet": {
                      "type": "boolean",
                      "description": "False if tiles were still arriving at the timeout."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/frame": {
      "get": {
        "summary": "The current view, as an image",
        "description": "The response body is the picture. Call /wait first, or the frame may catch tiles mid-stream.",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "png",
                "jpg"
              ],
              "default": "png"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The rendered frame",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/shutdown": {
      "post": {
        "summary": "Stop the renderer and exit the process",
        "responses": {
          "200": {
            "description": "Acknowledged; the process halts immediately after."
          }
        }
      }
    },
    "/providers": {
      "get": {
        "summary": "Imagery sources this renderer can use",
        "responses": {
          "200": {
            "description": "the sources",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "providers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/objects": {
      "get": {
        "summary": "The loaded objects: peaks, places, alpine huts, pistes and area names",
        "description": "Every object the app holds around the viewer, with where its label sits on the frame. POIs (kind peak, place, alpine_hut, piste) carry the map's elevation, prominence where known, their tags, whether the label was drawn in the last frame and, if not, which gate hid it. Area names (kind area; type range, island, lake, city, ...) carry their ellipse and, when drawn, the label plate. Screen coordinates are pixels of the frame, origin top-left, y down - the convention of the image GET /frame returns. Labels lag the terrain after a move: call /wait first, or poll until drawn objects appear.",
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "displayable",
                "all"
              ],
              "default": "displayable"
            },
            "description": "displayable: the POIs the app selected as labelling candidates for the current view. all: every POI loaded from the tiles in memory - can be tens of thousands."
          },
          {
            "name": "drawn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "true: only objects whose label was actually drawn in the last frame."
          }
        ],
        "responses": {
          "200": {
            "description": "the objects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "objects": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "kind",
                          "name",
                          "lat",
                          "lon",
                          "drawn"
                        ],
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "peak",
                              "place",
                              "alpine_hut",
                              "piste",
                              "area"
                            ]
                          },
                          "name": {
                            "type": "string"
                          },
                          "lat": {
                            "type": "number"
                          },
                          "lon": {
                            "type": "number"
                          },
                          "elevation_m": {
                            "type": "number",
                            "description": "metres above sea level; for an area, its highest point"
                          },
                          "prominence_m": {
                            "type": "number",
                            "description": "peaks only, when the map data carries it"
                          },
                          "tags": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string"
                            },
                            "description": "POIs only: the map's key/value tags"
                          },
                          "drawn": {
                            "type": "boolean",
                            "description": "the label was on screen in the last frame"
                          },
                          "hidden": {
                            "type": "object",
                            "description": "POIs only: why a label is not drawn",
                            "properties": {
                              "by_mountains": {
                                "type": "boolean",
                                "description": "Behind nearer terrain. For areas this is the verdict cached across decision frames, and is also true for an area not yet tested."
                              },
                              "behind": {
                                "type": "boolean"
                              },
                              "by_label": {
                                "type": "boolean"
                              },
                              "off_frame": {
                                "type": "boolean",
                                "description": "the label passed every gate but lies outside the frame"
                              }
                            }
                          },
                          "screen": {
                            "type": "object",
                            "description": "POIs: the anchor the label line points at, which may lie outside the frame when the summit is above the view. Areas: the label plate; only present when drawn.",
                            "properties": {
                              "x": {
                                "type": "number"
                              },
                              "y": {
                                "type": "number"
                              },
                              "width": {
                                "type": "number"
                              },
                              "height": {
                                "type": "number"
                              }
                            }
                          },
                          "type": {
                            "type": "string",
                            "description": "areas only: range, island, lake, city, ..."
                          },
                          "semi_major_km": {
                            "type": "number"
                          },
                          "semi_minor_km": {
                            "type": "number"
                          },
                          "rotation_deg": {
                            "type": "number"
                          },
                          "visible_range_km": {
                            "type": "number"
                          },
                          "population": {
                            "type": "integer"
                          },
                          "candidate": {
                            "type": "boolean",
                            "description": "Areas only: survived the geometric culls of the last frame (range, in front of the camera, on screen, summit in view, not behind terrain); only the de-overlap round or a held selection then kept it off the picture."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/gpx": {
      "post": {
        "summary": "Draw the paths of a GPX document on the terrain",
        "description": "Adds the document's tracks and routes to what is drawn, the way the app draws a loaded GPX file - but without flying the camera to frame them: the caller places the camera. Give the document inline as xml, or the path of a file the renderer can read.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "xml": {
                    "type": "string",
                    "description": "The GPX document."
                  },
                  "path": {
                    "type": "string",
                    "description": "A GPX file on the renderer's machine."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Loaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "paths": {
                      "type": "integer",
                      "description": "How many paths the document held; 0 means nothing was drawn."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Neither xml nor path given"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This document",
        "responses": {
          "200": {
            "description": "the API description"
          }
        }
      }
    },
    "/photo": {
      "post": {
        "summary": "Put a photograph behind the terrain",
        "description": "As the app's gallery button: the picture is shown behind the terrain, drawn as outlines over it, EXIF orientation honoured. With go_to_exif (default true) and a GPS position in the file the viewpoint moves there first, downloading and waiting as /position does when the two timeouts are given. Then POST /photo/match to point the camera the way the photo looks, and GET /frame for the picture with the terrain's labels over it - it is cropped to the photo's drawn size and carries the pose in its EXIF block.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "A JPEG or PNG file the renderer's process can read."
                  },
                  "image_base64": {
                    "type": "string",
                    "description": "The JPEG or PNG bytes inline, base64."
                  },
                  "go_to_exif": {
                    "type": "boolean",
                    "default": true
                  },
                  "download_timeout_ms": {
                    "type": "integer"
                  },
                  "await_tiles_ms": {
                    "type": "integer"
                  },
                  "load_timeout_ms": {
                    "type": "integer",
                    "default": 60000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ok, width, height, vertical_fov_deg|null (from the EXIF focal length), location {lat, lon}|null, moved, downloaded, quiet}"
          },
          "400": {
            "description": "Neither path nor image_base64, or an unreadable picture"
          }
        }
      },
      "delete": {
        "summary": "Take the photograph down",
        "responses": {
          "200": {
            "description": "Removed"
          }
        }
      }
    },
    "/photo/match": {
      "post": {
        "summary": "Match the photo's skyline and turn the camera",
        "description": "Runs the skyline matcher for the loaded photo against the terrain around the current position and turns the camera to the best pose, confident or not - the response says which. Blocks for the matching (a few seconds) and the turn.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "default": 3,
                    "description": "Retries a few seconds apart while the terrain is still streaming in."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ok, matched, bearing_deg, pitch_deg, vertical_fov_deg, roll_deg, cost, ratio, relief_deg, confident} - or matched false with an error"
          },
          "400": {
            "description": "No photo loaded"
          }
        }
      }
    },
    "/photo/overlay": {
      "post": {
        "summary": "How the terrain is drawn over the photo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "outline_alpha": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Opacity of the terrain outlines (the photo bar's slider)."
                  },
                  "terrain_alpha": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Opacity of the rendered terrain over the photo; 0 draws outlines only."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied"
          }
        }
      }
    }
  }
}
