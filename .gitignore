*.pbf
*.png
*.jpg
*.jpeg
*.mp4
*.webm
*.ttf
# ...except the one face the app renders every label with (see assets/liberation_fonts/LICENSE):
# the build needs it, and it is not something a build step could produce.
!assets/liberation_fonts/*.ttf
*.pem
*.jks

*.gpx
*.ogg

# ...but the desktop launcher icons are source, not generated output: construo reads
# logo.png to set the icon on the Windows executable and the linux/ sizes go into
# the .deb, so a fresh clone cannot build an installer without them.
!desktop/icons/*.png
!desktop/icons/linux/*.png

# The F-Droid / store listing (fastlane layout): icon and screenshots are the listing, not
# build output.
!fastlane/**/*.png
!fastlane/**/*.jpg

LICENSE.html
privacy_statement.html
THIRD_PARTY_LICENSES.html

