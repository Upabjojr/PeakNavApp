<?xml version="1.0" encoding="utf-8"?>
<!-- The tutorial's own layout: its slideshow fills the page and puts the caption at the very
     bottom, so the Back button cannot float over the web view as it does on the licence page -
     it sits under it, with the slideshow taking the rest of the height. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="32dp"
    android:layout_marginBottom="16dp"
    android:orientation="vertical"
    tools:context=".views.AppTutorialAndroidView">

    <WebView
        android:id="@+id/app_tutorial_android_web_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/button_app_tutorial_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_margin="12dp"
        android:text="Back" />

</LinearLayout>
